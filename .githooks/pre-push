#!/bin/sh
# Source and its pinned commit are necessarily written in two commits.
# Validate the actual outgoing branch tip after both commits exist.
set -eu
root=$(git rev-parse --show-toplevel)
while read -r local_ref local_oid remote_ref remote_oid; do
  case "$remote_ref" in refs/heads/*) ;; *) continue ;; esac
  case "$local_oid" in *[!0]*) ;; *) continue ;; esac
  python3 "$root/ci/verify-contracts.py" --images-only --image-commit "$local_oid"
done
