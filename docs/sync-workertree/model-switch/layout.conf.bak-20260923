# 主目录与工位布局。mb 与 five-repos-sync 共用这一份。
# 路径相对家目录，本机与远端各自展开 $HOME。
#
#   主目录  $HOME/<LAYOUT_MASTER>/<仓>
#   工位    $HOME/<LAYOUT_WORKTREES>/<名字>/<仓>
#   工位名 = 目录名 = Git 分支名（master 除外，主目录检出 master）
#
# LAYOUT_WORKSPACES：具名工位（不含 master）。
#   mb worktree add --all --all 一次挂出这里全部工位 × 全部仓；
#   sync 的工作区 = master + 这一列。

LAYOUT_MASTER="master"
LAYOUT_WORKTREES="worktrees"
LAYOUT_WORKSPACES=(cursor kimi luna opus qwen)
