{% for name in ['casdoor','knowbase'] %}
---
apiVersion: v1
kind: Service
metadata: {name: {{ name }}-tls, namespace: {{ app_namespace }}}
spec:
  type: ExternalName
  externalName: traefik.{{ ingress_namespace }}.svc.cluster.local
  ports: [{name: https, port: 443}]
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: {{ name }}-service-access
  namespace: {{ app_namespace }}
  annotations: {traefik.ingress.kubernetes.io/router.entrypoints: websecure}
spec:
  ingressClassName: sunmoon
  tls: [{secretName: service-access-tls, hosts: [{{ service_access_hosts[name] }}]}]
  rules:
    - host: {{ service_access_hosts[name] }}
      http:
        paths:
{# knowbase 只放行内部接口的三个前缀：知识源（摄入、检索）、用户资料第一版（SDD 0042，随 qwen 这批代码删）与
   数据第四版 user-data/v2（SDD 0043，knowbench、knowlab、knowfeed 凭服务关系或用户令牌调） #}
{% for path in (['/api/internal/v1/knowledge', '/api/internal/v1/user-data', '/api/internal/v2/user-data'] if name == 'knowbase' else ['/']) %}
          - path: {{ path }}
            pathType: Prefix
            backend:
              service: {name: {{ 'knowbase-api' if name == 'knowbase' else 'casdoor' }}, port: {name: http}}
{% endfor %}
{% endfor %}
{% for name, route in (service_access_routes | default({})).items() %}
---
apiVersion: v1
kind: Service
metadata: {name: {{ name }}-tls, namespace: {{ app_namespace }}}
spec:
  type: ExternalName
  externalName: traefik.{{ ingress_namespace }}.svc.cluster.local
  ports: [{name: https, port: 443}]
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: {{ name }}-service-access
  namespace: {{ app_namespace }}
  annotations: {traefik.ingress.kubernetes.io/router.entrypoints: websecure}
spec:
  ingressClassName: sunmoon
  tls: [{secretName: service-access-{{ name }}-tls, hosts: [{{ route.host }}]}]
  rules:
    - host: {{ route.host }}
      http:
        paths:
          - path: {{ route.path }}
            pathType: Prefix
            backend:
              service: {name: {{ name }}-api, port: {name: http}}
{% endfor %}
